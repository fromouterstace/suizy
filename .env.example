# Local shell only. This file is not loaded automatically.
# Copy to .env and run: node --env-file=.env dist/src/server.js (after pnpm build).
APP_ENV=development
NODE_ENV=development
PORT=3000
RESOURCE_NAMESPACE=suizy-development
PUBLIC_BASE_URL=http://localhost:3000

