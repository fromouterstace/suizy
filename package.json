{
  "name": "suizy",
  "version": "0.0.0",
  "private": true,
  "description": "A personal meeting assistant for Google Workspace.",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=10.26.1 <11"
  },
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level high",
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:security": "pnpm run audit:dependencies",
    "check:test-filenames": "node scripts/check_test_filenames.mjs",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "eslint --max-warnings 0 src tests scripts eslint.config.mjs",
    "lint:fix": "eslint --fix --max-warnings 0 src tests scripts eslint.config.mjs",
    "smoke": "tsx --test tests/app-smoke-test.ts",
    "start": "node dist/src/server.js",
    "test": "pnpm run check:test-filenames && pnpm run smoke",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
